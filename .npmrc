# npm-only setting: npm skips dependency versions published less than
# 7 days ago. pnpm does not read it and applies its own default of 1 day;
# override that with `minimumReleaseAge` (in minutes) in
# pnpm-workspace.yaml. npm itself refuses to run commands in this repo,
# because devEngines.packageManager requires pnpm.
min-release-age=7
